.env

# Data warehouse (regenerate from primary sources; not committed)
data/

# Pipeline outputs (regenerate via scripts/run_full_pipeline.py; not
# committed). Anchored to the repo root (leading /) -- unanchored "outputs/"
# would also match src/congressional_sales/outputs/ and tests/outputs/,
# the real source packages for Tasks 24/25/26 and their tests, silently
# hiding any NEW file added there from `git add -A`/`git add .` (caught
# during the whole-branch review: `git add` on those directories' already-
# tracked files warned "ignored by one of your .gitignore files").
/outputs/

# Rendered paper formats (regenerate via `pandoc paper/draft.md -o
# paper/draft.docx` / `--pdf-engine=typst -o paper/draft.pdf`; draft.md
# is the single source of truth, not committed as binaries)
paper/draft.docx
paper/draft.pdf
